# Kopieer dit bestand naar .env.local en vul je eigen gegevens in.
# API-sleutel van https://resend.com (API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Afzender: moet een domein zijn dat in Resend geverifieerd is
MAIL_FROM="Dutch Branders <info@dutchbranders.nl>"
# Waar nieuwe aanvragen naartoe gaan
MAIL_TO=info@dutchbranders.nl
# Optioneel: zet de hele site achter een wachtwoord (preview voor collega's).
# Leeg laten of weghalen zodra de site echt live gaat.
SITE_PASSWORD=
